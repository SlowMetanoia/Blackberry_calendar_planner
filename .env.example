# Values after "#cloud:" are the polza.ai equivalents for a setup without local
# models. Both python-dotenv and Docker Compose drop such inline comments.
# Polza needs one API key for LLM_API_KEY, EMBEDDING_API_KEY and STT_API_KEY.
DATABASE_URL=postgresql+asyncpg://planner:planner@postgres:5432/planner
REDIS_URL=redis://redis:6379/0
AUTH_SESSION_TTL_DAYS=7
AUTH_SESSION_RENEW_INTERVAL_HOURS=24
LLM_BASE_URL=http://host.docker.internal:1234 #cloud: https://polza.ai/api
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_REQUIRED=true
LLM_REASONING_EFFORT=none
LLM_STARTUP_TIMEOUT_SECONDS=5
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
GUARD_ENABLED=true
GUARD_BASE_URL=http://guard:8090
GUARD_API_KEY=
GUARD_MODEL=auren-research/lunaris-guardv3
GUARD_MIN_CONFIDENCE=0.9
GUARD_REQUEST_TIMEOUT_SECONDS=10
GUARD_PORT=8090
GUARD_MAX_LENGTH=2048
GUARD_INJECTION_THRESHOLD=0.5
GUARD_SAFETY_THRESHOLD=0.5
AGENT_MAX_MODEL_TURNS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_OBSERVATION_ITEMS=100
PROMPTS_PATH=prompts/planner-agent.yaml
PROMPTS_CACHE_TTL_SECONDS=30
EMBEDDING_BASE_URL=http://host.docker.internal:1234 #cloud: https://polza.ai/api
EMBEDDING_API_KEY=
EMBEDDING_MODEL=ggml-org/embeddinggemma-300M-GGUF #cloud: qwen/qwen3-embedding-4b
# The vector column is Vector(768); other sizes need a migration. Vectors of a
# previous EMBEDDING_MODEL are skipped by semantic search until re-indexed.
EMBEDDING_DIMENSIONS=768
EMBEDDING_REQUEST_TIMEOUT_SECONDS=120
EMBEDDING_INDEX_WAIT_SECONDS=60
EMBEDDING_BATCH_SIZE=32
SEARCH_FUZZY_THRESHOLD=0.5
SEARCH_SEMANTIC_THRESHOLD=0.34
STT_BASE_URL=http://host.docker.internal:9000/v1 #cloud: https://polza.ai/api/v1
STT_API_KEY=
STT_MODEL=gigaam-v3-e2e-rnnt #cloud: ai-sage/gigaam-v3
AUDIO_MAX_UPLOAD_BYTES=26214400
VOICE_TICKET_TTL_SECONDS=60
VOICE_MAX_PCM_BYTES=3200000
VOICE_MAX_DURATION_SECONDS=60
VOICE_TERMINAL_WAIT_SECONDS=180
TTS_BASE_URL=http://tts:8081
TTS_MODEL=v5_6_ru 
TTS_MODEL_PATH=/models-local/v5_6_ru.pt
TTS_API_KEY=
TTS_REQUEST_TIMEOUT_SECONDS=60
TTS_PORT=8081
# Host ports published by Docker Compose.
API_PORT=8000
WEB_PORT=3000
CREATE_AUTO_CONFIRM_SECONDS=15
# Web Push: one persistent VAPID key pair shared by API and notifier.
# Leave empty to use only the durable in-app inbox.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
# Google sign-in and two-way Google Calendar sync (optional).
# OAuth client type "Web application"; authorized redirect URI:
#   ${FRONTEND_BASE_URL}/api/auth/google/callback
# CALENDAR_TOKEN_KEY is any long random secret used to encrypt stored refresh tokens.
FRONTEND_BASE_URL=http://localhost:3000
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URL=
CALENDAR_TOKEN_KEY=
CALENDAR_SYNC_PAST_DAYS=30
CALENDAR_HTTP_TIMEOUT_SECONDS=20
